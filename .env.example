```dotenv
# ============================================================
# FLASK APPLICATION
# ============================================================

# Replace with a strong randomly generated value.
SECRET_KEY=change-me


# ============================================================
# MYSQL
# ============================================================

MYSQL_DATABASE=microblog
MYSQL_USER=microblog
MYSQL_PASSWORD=change-me

# The Docker Compose configuration currently constructs
# DATABASE_URL from the MYSQL_* variables.
#
# When running outside Docker, this can instead be supplied
# directly if required.
#
# DATABASE_URL=mysql+pymysql://user:password@host:3306/database


# ============================================================
# EMAIL
# ============================================================

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=


# ============================================================
# ELASTICSEARCH
# ============================================================

# Docker example:
ELASTICSEARCH_URL=https://elasticsearch:9200

ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me

# Path inside the Flask container to the CA certificate used
# to verify the Elasticsearch HTTPS connection.
ELASTICSEARCH_CA_CERT=/certs/ca.crt


# ============================================================
# LIBRETRANSLATE
# ============================================================

# Docker Compose service address:
LIBRETRANSLATE_URL=http://libretranslate:5000
```
